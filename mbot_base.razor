################################################################
### Muls Dexxer Bot - v1.0.20260822.1
### Based on Jaseowns' Premium Dexxer Bot (June 2026 version)
#
# NEW Features
# - Poison can now be reapplied early
# - Smart Weapon Equip
# - Smart Shield Equip
# - Support automatic full codex hotbar in addition to abilities hot bar
# - Optimized Chivalry
# - Optimized Combat Loop
# - Optimized barding
# - Optimized main run loop (moved several init-once items outside of the main run loop)
# - Removed support for tamer archetype
#
# Latest release and changelog
# https://github.com/tmuls/muls-dexxer-bot/releases
#
################################################################
#
# Jaseowns Premium Bot Comparison
# 46% smaller file size
# 65.7% fewer main loop branches -- 851 -> 292 branches (559 removed)
#
################################################################

@setvar! mbot_version "v1.0.20260822.1"

##### Archetype Detection
@setvar! mbot_BardDetected 0
if skill "Discordance" > 0 or skill "Peacemaking" > 0 or skill "Provocation" > 0
    @setvar! mbot_BardDetected 1
endif

##### Poison Sting Tracking
@setvar! poison_check_timer_cd 6000
settimer poison_check_timer poison_check_timer_cd

@setvar! poison_apply_timer_cd 600000
@setvar! poison_reapply_timer_cd 598000
@setvar! poison_failed_timer_cd 597000
settimer poison_reapply_timer 0

removelist poison_check_list
createlist poison_check_list
pushlist poison_check_list " (3."
pushlist poison_check_list " (2."
pushlist poison_check_list " (1."
pushlist poison_check_list " (0."

##### Target State & Overhead Timers
@setvar! mbot_CurrentBotTarget 0
@setvar! mbot_FightingRangeCheck 12

settimer mbot_CurrentBotTargetOverheadTimer mconfig_Target_CurrentOverheadTimerCD
settimer mbot_CurrentBotTargetUnableToAttackOverheadTimer mconfig_Target_UnableToAttackOverheadTimerCD
settimer mbot_IgnoreMobOverheadTimer mconfig_Target_IgnoreMobOverheadTimerCD

##### Chivalry Ability Timers
@setvar! mbot_HolyLightTimerCD 30000
if not timerexists mbot_HolyLightTimer
    settimer mbot_HolyLightTimer mbot_HolyLightTimerCD
endif
@setvar! mbot_NobleSacrificeTimerCD 30000
if not timerexists mbot_NobleSacrificeTimer
    settimer mbot_NobleSacrificeTimer mbot_NobleSacrificeTimerCD
endif
@setvar! mbot_DivineFuryTimerCD 30000
if not timerexists mbot_DivineFuryTimer
    settimer mbot_DivineFuryTimer mbot_DivineFuryTimerCD
endif
@setvar! mbot_ConsecrateWeaponTimerCD 30000
if not timerexists mbot_ConsecrateWeaponTimer
    settimer mbot_ConsecrateWeaponTimer mbot_ConsecrateWeaponTimerCD
endif
@setvar! mbot_CleanseByFireTimerCD 30000
if not timerexists mbot_CleanseByFireTimer
    settimer mbot_CleanseByFireTimer mbot_CleanseByFireTimerCD
endif
@setvar! mbot_CloseWoundsTimerCD 30000
if not timerexists mbot_CloseWoundsTimer
    settimer mbot_CloseWoundsTimer mbot_CloseWoundsTimerCD
endif
@setvar! mbot_EnemyOfOneTimerCD 30000
if not timerexists mbot_EnemyOfOneTimer
    settimer mbot_EnemyOfOneTimer mbot_EnemyOfOneTimerCD
endif

@setvar! mbot_Chiv_SymbolCheckTimerCD 1000
if not timerexists mbot_Chiv_SymbolCheckTimer
    settimer mbot_Chiv_SymbolCheckTimer mbot_Chiv_SymbolCheckTimerCD
endif

##### Combat Support Timers
@setvar! mbot_LOSCheckTimerCD 500
if not timerexists mbot_LOSCheckTimer
    settimer mbot_LOSCheckTimer mbot_LOSCheckTimerCD
endif

@setvar! mbot_UseItemTimerCD 650
settimer mbot_UseItemTimer mbot_UseItemTimerCD

##### Potion Triggers & Overhead Display
if mconfig_Potion_ShowOverheads = 1
    settimer mbot_Potion_Cure_Overhead_IfCountIsLessThan_Timer mconfig_Potion_CureOverheadIfCountIsLessThanTimerCD
    settimer mbot_Potion_Heal_Overhead_IfCountIsLessThan_Timer mconfig_Potion_HealOverheadIfCountIsLessThanTimerCD
    settimer mbot_Potion_Explosion_Overhead_IfCountIsLessThan_Timer mconfig_Potion_ExplosionOverheadIfCountIsLessThanTimerCD
endif

##### Cooldown System Warmup (forces the cooldown table to exist before first real use)
cooldown "Moving" 5000
if not cooldown "Moving"
    overhead "Moving" 79
else
    cooldown "Moving" 0
endif

##### Parry / Shield Setup
if skill "Parrying" < 80
    @setvar! mconfig_Parry_AutoTaunting 0
    @setvar! mconfig_Parry_AutoAoeTaunting 0
else

    cooldown "Bulwark" 5000
    if not cooldown "Bulwark"
        overhead "Bulwark" 79
    else
        cooldown "Bulwark" 0
    endif

    @setvar! mbot_Parry_SwitchCodexTimerCD 1000

    if not timerexists mbot_Parry_SwitchCodexTimer
        settimer mbot_Parry_SwitchCodexTimer mbot_Parry_SwitchCodexTimerCD
    endif

    if not timerexists mbot_TauntingTimer
        settimer mbot_TauntingTimer mconfig_Parry_TauntingTimerCD
    endif
endif

##### Potion Satchel & Refresh Trigger
@setvar! mbot_PotionSatchel backpack
if findlayer self Outerbody as mbot_MaybePotionSatchel
    @setvar! mbot_PotionSatchel mbot_MaybePotionSatchel
endif

##### Bard Config/Setup (If a bard archetype was detected)
if mbot_BardDetected = 1

    if skill "Discordance" >= 50 and mconfig_Bard_DiscordAutomatically = 1
        @setvar! mbot_Bard_CanDiscord 1
    else
        @setvar! mbot_Bard_CanDiscord 0
    endif

    if skill "Peacemaking" >= 50 and mconfig_Bard_PeaceAutomatically = 1
        @setvar! mbot_Bard_CanPeacemake 1
    else
        @setvar! mbot_Bard_CanPeacemake 0
    endif

    if skill "Provocation" >= 50 and mconfig_Bard_ProvoAutomatically = 1
        @setvar! mbot_Bard_CanProvo 1
    else
        @setvar! mbot_Bard_CanProvo 0
    endif

    # Bard Variables
    if mbot_Bard_CanProvo = 1
        @setvar! mbot_BARD_PROVO_COUNTER 0
        @setvar! mbot_BARD_TARGET1 0
        @setvar! mbot_BARD_TARGET2 0
        @setvar! mbot_BARD_TARGET_RANGECHECK 8
        @setvar! mbot_BARD_TARGET_RANGECHECK_TIMERCD 1000
        settimer mbot_BARD_TARGET_RANGECHECK_TIMER mbot_BARD_TARGET_RANGECHECK_TIMERCD
    endif

    settimer mbot_BOT_BardBuffTimer 10000

    @setvar! mbot_instrumentCheckTimerCD 10000
    settimer mbot_instrumentCheckTimer mbot_instrumentCheckTimerCD

endif

##### Explosion Pot & Used-Skill Timer
if mconfig_Potion_AutoExplodePot = 1
    @setvar! mbot_AutoExplodePotTimerCD 15000
    settimer mbot_AutoExplodePotTimer mbot_AutoExplodePotTimerCD
endif

@setvar! mbot_UsedSkillTimerCD 10000
settimer mbot_UsedSkillTimer mbot_UsedSkillTimerCD

##### Weapon Ability Hotbar Setup
if mconfig_Weapon_ForceAbilitiesHotBarToShow = 1 and not gumpexists 3954121934
    say "[abilitieshotbar"
    waitforgump 3954121934 1000
    if not gumpexists 3954121934
        overhead "!!!!!!!!!! ABILITIES HOTBAR GUMP NOT FOUND !!!!!!!!!!" 34
    endif
endif

if mconfig_Weapon_ForceCodexHotBarToShow = 1 and not gumpexists 2016719803
    say "[codexhotbar"
    waitforgump 2016719803 1000
    if not gumpexists 2016719803
        overhead "!!!!!!!!!! CODEX HOTBAR GUMP NOT FOUND !!!!!!!!!!" 34
    endif
endif

settimer mbot_UseAbilityTimer mconfig_Weapon_UseAbilityTimerCD

##### Alchemy-Gated Features
if skill "Alchemy" < 80
    @setvar! mconfig_Potion_HasPanacea 0
    @setvar! mconfig_Potion_AutoExplodePot 0
endif

##### Panacea & Cleansing Brew Timers
@setvar! mbot_UsePanaceaTimerCD 30500
if not timerexists mbot_UsePanaceaTimer
    settimer mbot_UsePanaceaTimer mbot_UsePanaceaTimerCD
endif

@setvar! mbot_UseCleansingBrewTimerCD 120500
if not timerexists mbot_UseCleansingBrewTimer
    settimer mbot_UseCleansingBrewTimer mbot_UseCleansingBrewTimerCD
endif

##### Weapon State Tracking
if not varexist mbot_BOT_CurrentRightHandWeapon
    @setvar! mbot_BOT_CurrentRightHandWeapon 0
endif
if findlayer self righthand as mbot_RightHandWeapon
    @setvar! mbot_BOT_CurrentRightHandWeapon mbot_RightHandWeapon
endif

if not varexist mbot_BOT_CurrentLeftHandWeapon
    @setvar! mbot_BOT_CurrentLeftHandWeapon 0
endif
if findlayer self lefthand as mbot_LeftHandWeapon
    @setvar! mbot_BOT_CurrentLeftHandWeapon mbot_LeftHandWeapon
endif

##### Bandage Timer & Red Pouch Tracking
@setvar! mbot_BandageTimerCD 20000
if not timerexists mbot_BandageTimer
    settimer mbot_BandageTimer mbot_BandageTimerCD
endif

@setvar! mbot_RedPouchCountTotal 0

##### Tracking
if skill "Tracking" > 0
    if not findbuff "tracking"
        while insysmsg "You will now hunt all hostile players."
        endwhile

        settimer mbot_TrackingGumpTimer 0
        while not gumpexists 4267467659 and timer mbot_TrackingGumpTimer < 1000
            useskill 'tracking'
            getlabel backpack mbot_PingCheck
        endwhile

        if gumpexists 4267467659
            settimer mbot_TrackingGumpTimer 0
            while not insysmsg "You will now hunt all hostile players." and timer mbot_TrackingGumpTimer < 1000
                gumpresponse 8 4267467659
                waitforgump 4267467659 1000
            endwhile
            if insysmsg "You will now hunt all hostile players."
                gumpresponse 6 4267467659
                getlabel backpack mbot_PingCheck
            else
                overhead "!!!!!!!!!! TRACKING GUMP TIMED OUT - GIVING UP !!!!!!!!!!" 34
            endif
        else
            overhead "!!!!!!!!!! TRACKING GUMP NEVER APPEARED - GIVING UP !!!!!!!!!!" 34
        endif
        gumpclose 4267467659
    endif
endif

##### Run once flags
@setvar! mbot_SmartEquipHasRun 0

##### Version Announcement
if mconfig_General_ShowVersion = 1
    sysmsg "Muls Dexxer Bot {{mbot_version}}"
endif

while not dead
    ##### Out of Combat: Sysmsg Cleanup & Self-Bandaging
    while insysmsg "You deliver a poison sting"
        cooldown "Poison Sting" 5000
    endwhile

    // Handle manual bandage
    while insysmsg "You begin applying"
        settimer mbot_BandageTimer 0
    endwhile

    // Reset the timer if we finished
    while insysmsg "You finish applying" or insysmsg "You heal what little" or insysmsg "barely help" or insysmsg "You fail to resurrect" or insysmsg "You are able to resurrect"
        settimer mbot_BandageTimer mbot_BandageTimerCD
    endwhile
    
    if skill "Healing" > 0 and findtype 3617 self 
        if timer mbot_BandageTimer >= mbot_BandageTimerCD and not targetexists
            // and not queued
            if poisoned or findbuff "disease" or findbuff "bleed"
                hotkey "Bandage Self"
            elseif diffhits > mconfig_Healing_AutoBandageHpDiffTrigger
                hotkey "Bandage Self"
            endif
            getlabel backpack mbot_PingCheck
            if insysmsg "You begin applying"
                settimer mbot_BandageTimer 0
            endif
        endif
    endif
    
    ##### Out of Combat: Thief Pouch Alert
    if mconfig_Thief_AlertRedPouchPop = 1 and counttype 3705 backpack 38 as mbot_RedPouchCount
        if mbot_RedPouchCountTotal != 0 and mbot_RedPouchCountTotal != mbot_RedPouchCount
            overhead "Warning: THIEF we lost a pouch!" 34
        else
            @setvar! mbot_RedPouchCountTotal mbot_RedPouchCount    
        endif
    endif

    if mconfig_SmartEquip_RunOnce = 0 or mbot_SmartEquipHasRun = 0
        ##### Smart Weapon Equip
        if mconfig_Weapon_SmartEquip = 1
            @setvar! mbot_HasWeapon 0
            if findlayer self righthand
                @setvar! mbot_HasWeapon 1
            elseif findlayer self lefthand
                @setvar! mbot_HasWeapon 1
                if findtype 7026|7027|7029|7031|7033|7034|7035|7107|7109|31002|31130 lefthand
                    @setvar! mbot_HasWeapon 0
                endif
            endif
            if mbot_HasWeapon = 0
                if find mbot_BOT_CurrentRightHandWeapon backpack
                    dclick mbot_BOT_CurrentRightHandWeapon
                    getlabel backpack mbot_PingCheck
                endif
            endif

            if mbot_HasWeapon = 0
                overhead "Smart weapon equip searching..." 66
                @clearignore
                @setvar! mbot_FoundFallbackWeapon 0
                while mbot_FoundFallbackWeapon = 0 and findtype 31017|31019|31021|31023|31025|31027|31029|31031|31033|31035|31037|31038|31041|31043|31045|31047|31049|31051|31053|31055|3920|5042|5117|30990|30993|30994|30995|31184|31186|67773|67774|67775|67776|67777|67778|3719|3922|3938|5121|5123|5125|30989|30992|30996|30997|30998|31176|31188|3568|3721|3932|5040|5044|5112|5127|5177|5179|5181|30991|30999|31000|31001|31014|31178|31180|31182|3909|3911|3913|3915|3917|3934|3937|5046|5049|5115|5119|5182|5185|5187|30988|31128|31190|67713|67723|67734|67744|67754|67764|22187|31141|31142 backpack as mbot_WeaponCandidate
                    getlabel mbot_WeaponCandidate mbot_WeaponCandidateDesc
                    if " aspect" in mbot_WeaponCandidateDesc or "exceptional " in mbot_WeaponCandidateDesc or "supremely" in mbot_WeaponCandidateDesc or "exceedingly" in mbot_WeaponCandidateDesc or "vanquishing" in mbot_WeaponCandidateDesc or "power" in mbot_WeaponCandidateDesc
                        overhead "Weapon found! Auto-equipping." 66
                        dclick mbot_WeaponCandidate
                        getlabel backpack mbot_PingCheck                        
                        @setvar! mbot_FoundFallbackWeapon 1
                        @setvar! mbot_BOT_CurrentRightHandWeapon mbot_WeaponCandidate
                    else
                        @ignore mbot_WeaponCandidate
                    endif
                endwhile
                @clearignore
                if mbot_FoundFallbackWeapon = 0
                    if mconfig_Weapon_AutoRecallWhenEmpty = 1
                        for 3
                            overhead "Weapon not found, auto-recalling home" 33
                            wait 250
                        endfor
                        hotkey "Play Script: Combat\Dexxer\mbot_recall_home"
                    else
                        overhead "WARNING: Weapon not found!" 33
                    endif
                endif
            endif
        endif

        ##### Smart Shield Equip
        # Special 2h ids that are not found in the lefthand layer when equipped (pickaxe)
        if mconfig_Shield_SmartEquip = 1 and not findtype 3718 righthand
            if not findlayer self lefthand
                if find mbot_BOT_CurrentLeftHandWeapon backpack
                    dclick mbot_BOT_CurrentLeftHandWeapon
                    getlabel backpack mbot_PingCheck
                endif
            endif

            if not findlayer self lefthand
                overhead "Smart shield equip searching..." 66
                @clearignore
                @setvar! mbot_FoundFallbackShield 0
                while mbot_FoundFallbackShield = 0 and findtype 7026|7027|7029|7031|7033|7034|7035|7107|7109|31002|31130 backpack as mbot_ShieldCandidate
                    getlabel mbot_ShieldCandidate mbot_ShieldCandidateDesc
                    if "exceptional" in mbot_ShieldCandidateDesc or "invulnerable" in mbot_ShieldCandidateDesc or "fortified" in mbot_ShieldCandidateDesc
                        dclick mbot_ShieldCandidate
                        getlabel backpack mbot_PingCheck
                        overhead "Shield found! Auto-equipping..." 66
                        @setvar! mbot_FoundFallbackShield 1
                        @setvar! mbot_BOT_CurrentLeftHandWeapon mbot_ShieldCandidate
                    else
                        @ignore mbot_ShieldCandidate
                    endif
                endwhile
                @clearignore
                if mbot_FoundFallbackShield = 0
                    if mconfig_Shield_AutoRecallWhenEmpty = 1
                        for 3
                            overhead "Shield not found, auto-recalling home" 33
                            wait 250
                        endfor
                        hotkey "Play Script: Combat\Dexxer\mbot_recall_home"
                    else
                        overhead "WARNING: Shield not found!" 33
                    endif
                endif
            endif
        endif

        @setvar! mbot_SmartEquipHasRun 1
    endif

    ##### Out of Combat: Weapon Re-equip
    if casting
        settimer mbot_UseItemTimer 0
    endif

    if not queued and find mbot_BOT_CurrentRightHandWeapon backpack and timer mbot_UseItemTimer >= mbot_UseItemTimerCD
        if findlayer self righthand as mbot_RightHandWeapon
            @setvar! mbot_BOT_CurrentRightHandWeapon mbot_RightHandWeapon
        else
            dclick mbot_BOT_CurrentRightHandWeapon
            settimer mbot_UseItemTimer 0
        endif
    elseif not queued and find mbot_BOT_CurrentLeftHandWeapon backpack and timer mbot_UseItemTimer >= mbot_UseItemTimerCD
        if findlayer self lefthand as mbot_LeftHandWeapon
            @setvar! mbot_BOT_CurrentLeftHandWeapon mbot_LeftHandWeapon
        else
            dclick mbot_BOT_CurrentLeftHandWeapon
            settimer mbot_UseItemTimer 0
        endif
    endif
    
    ##### Out of Combat: Weapon Poison Application
    if skill "Poisoning" >= 50 and mconfig_Poison_AutomaticallyApply = 1
        if counttype 3850 mbot_PotionSatchel or counttype 3850 backpack
            @setvar! weapon_to_poison 0
            if findlayer self righthand as mbot_RightHandWeapon
                @setvar! weapon_to_poison mbot_RightHandWeapon
                @setvar! mbot_BOT_CurrentRightHandWeapon mbot_RightHandWeapon
            endif
            if weapon_to_poison != 0
                getlabel weapon_to_poison weapon_to_poisonDesc
                if timer poison_check_timer >= poison_check_timer_cd and timer poison_reapply_timer <= poison_reapply_timer_cd
                    settimer poison_check_timer 0                    
                    if "poison charge" in weapon_to_poisonDesc
                        foreach reapply_text in poison_check_list
                            if reapply_text in weapon_to_poisonDesc
                                overhead "Need to reapply poison: {{reapply_text}} charges remain"
                                settimer poison_reapply_timer poison_failed_timer_cd
                            endif                        
                        endfor                          
                    else
                        overhead "Weapon not poisoned, applying poison {{weapon_to_poisonDesc}}" 34
                        settimer poison_reapply_timer poison_failed_timer_cd
                    endif
                endif
                if insysmsg "You fail to apply a sufficient dose of poison." or insysmsg "grave mistake while"
                    overhead "Failed to apply Poison" 72     
                    settimer poison_reapply_timer poison_failed_timer_cd               
                elseif insysmsg "You apply the poison." 
                    overhead "Poison applied!" 72
                    settimer poison_reapply_timer 0
                endif
                if timer poison_reapply_timer >= poison_apply_timer_cd
                    overhead "Applying Poison" 72
                    menu weapon_to_poison 0
                    settimer poison_check_timer 0
                    settimer poison_reapply_timer poison_reapply_timer_cd
                endif
            endif
        else
            overhead "Out of poison pots!" 34
        endif
    endif

    ##### Out of Combat: Overweight Gold Drop
    if weight > maxweight and timer mbot_UseItemTimer >= mbot_UseItemTimerCD
        if findtype "gold coin" backpack as item
            while insysmsg "cannot drop anything"
            endwhile
            lift item mconfig_Weight_GoldToDropIfOverweight
            droprelloc 0 0
            getlabel backpack mbot_PingCheck
            if insysmsg "cannot drop anything"
                drop backpack -1 -1 -1
            endif
            settimer mbot_UseItemTimer 0
        else
            overhead "We are overweight and cannot drop anything" 34
        endif
    endif
    
    ##### Out of Combat: Potion Overhead Display
    if mconfig_Potion_ShowOverheads = 1

        if timer mbot_Potion_Cure_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_CureOverheadIfCountIsLessThanTimerCD
            @setvar! mbot_BOT_CurePotionCount 0
            if counttype 3847 mbot_PotionSatchel as mbot_TempPotionCount
                @setvar! mbot_BOT_CurePotionCount mbot_TempPotionCount
            elseif counttype 3847 backpack as mbot_TempPotionCount
                @setvar! mbot_BOT_CurePotionCount mbot_TempPotionCount
            endif
            if mbot_BOT_CurePotionCount < mconfig_Potion_CureOverheadIfCountIsLessThan
                if mbot_BOT_CurePotionCount = 0
                    overhead "Cure: Out of cures" 34
                else
                    overhead "Cures Remaining: {{mbot_BOT_CurePotionCount}}"
                endif
            endif
            settimer mbot_Potion_Cure_Overhead_IfCountIsLessThan_Timer 0
        endif
        
        if timer mbot_Potion_Heal_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_HealOverheadIfCountIsLessThanTimerCD
            @setvar! mbot_BOT_HealPotionCount 0
            if counttype 3852 mbot_PotionSatchel as mbot_TempPotionCount
                @setvar! mbot_BOT_HealPotionCount mbot_TempPotionCount
            elseif counttype 3852 backpack as mbot_TempPotionCount
                @setvar! mbot_BOT_HealPotionCount mbot_TempPotionCount
            endif
            if mbot_BOT_HealPotionCount < mconfig_Potion_HealOverheadIfCountIsLessThan
                if mbot_BOT_HealPotionCount = 0
                    overhead "Heal: Out of heals" 34
                else
                    overhead "Heal Remaining: {{mbot_BOT_HealPotionCount}}"
                endif
            endif
            settimer mbot_Potion_Heal_Overhead_IfCountIsLessThan_Timer 0
        endif
        
        if timer mbot_Potion_Explosion_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_ExplosionOverheadIfCountIsLessThanTimerCD
            @setvar! mbot_BOT_ExplosionPotionCount 0
            if counttype 3853 mbot_PotionSatchel as mbot_TempPotionCount
                @setvar! mbot_BOT_ExplosionPotionCount mbot_TempPotionCount
            elseif counttype 3853 backpack as mbot_TempPotionCount
                @setvar! mbot_BOT_ExplosionPotionCount mbot_TempPotionCount
            endif
            if mbot_BOT_ExplosionPotionCount < mconfig_Potion_ExplosionOverheadIfCountIsLessThan
                if mbot_BOT_ExplosionPotionCount = 0
                    overhead "Explosion: Out of explosions" 34
                else
                    overhead "Explosion Remaining: {{mbot_BOT_ExplosionPotionCount}}"
                endif
            endif
            settimer mbot_Potion_Explosion_Overhead_IfCountIsLessThan_Timer 0
        endif
        
    endif

    ##### Out of Combat: Food
    if not queued and not findbuff "food" and findtype "tray" backpack as mbot_FoodItem
        if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
            dclick mbot_FoodItem
            settimer mbot_UseItemTimer 0
        endif
    endif
    
    ##### Out of Combat: Panacea & Cure/Heal/Refresh Potions
    if mconfig_Potion_HasPanacea = 1 and timer mbot_UsePanaceaTimer >= mbot_UsePanaceaTimerCD
        if findbuff "bleed" or findbuff "disease"
            if findtype 3847 self 0 as mbot_UseItem
                dclick mbot_UseItem
                cooldown "Panacea" mbot_UsePanaceaTimerCD
                settimer mbot_UsePanaceaTimer 0
            endif
        endif
    endif
    
    # Potions
    if not queued and mconfig_Potion_UseCureAutomatically = 1 and poisoned and diffhits >= mconfig_Potion_CureHpDiffTrigger and findtype 3847 self as mbot_Potion
        if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
            dclick mbot_Potion
            settimer mbot_UseItemTimer 0
        endif
    endif
    
    if mconfig_Potion_UseHealAutomatically = 1 and diffhits >= mconfig_Potion_HealHpDiffTrigger and findtype 3852 self as mbot_Potion
        if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
            getlabel mbot_Potion mbot_PotionDesc
            if "next usable in" in mbot_PotionDesc
                // do nothing
            else
                dclick mbot_Potion
                settimer mbot_UseItemTimer 0
            endif
        endif
    endif

    if not queued and mconfig_Potion_UseRefreshAutomatically = 1 and diffstam >= mconfig_Potion_RefreshStamDiffTrigger and findtype 3851 self as mbot_Potion
        if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
            dclick mbot_Potion
            settimer mbot_UseItemTimer 0
        endif
    endif
    
    // Trapped
    ##### Out of Combat: Paralyze Escape (Trapped Pouch)
    if paralyzed and not queued
        if findtype "pouch" backpack 38
            yell "[pouch"
            getlabel backpack mbot_PingCheck
        else
            overhead "Out of Pouches!" 34
        endif
    endif

    ##### Out of Combat: Skinning
    if not queued and mconfig_Skinning_UseKnifeAutomatically = 1 and findtype 11552 backpack as mbot_SkinningKnife
        if findbuff "Actively Meditating"
            //do nothing
        elseif findtype 8198 ground -1 -1 2 as mbot_Corpse
            while not targetexists 
                dclick mbot_SkinningKnife
                wft 500
            endwhile
            while targetexists 
                hotkey "Target Self"
                getlabel backpack mbot_PingCheck
            endwhile
            @ignore mbot_Corpse
        endif
    endif
    
    ##### Out of Combat: Chivalry Symbol Count Detection
    if timer mbot_Chiv_SymbolCheckTimer >= mbot_Chiv_SymbolCheckTimerCD
        if not gumpexists 1387930325 and skill "chivalry" >= 50
            say '[chivalryhotbar'
            waitforgump 1387930325 500
            if not gumpexists 1387930325
                overhead "!!!!!!!!!! CHIVALRY HOTBAR GUMP NOT FOUND !!!!!!!!!!" 34
            endif
        endif
        if gumpexists 1387930325
