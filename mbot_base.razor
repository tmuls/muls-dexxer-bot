                                getlabel backpack mbot_PingCheck
                                if insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                                    if mconfig_Target_Overhead_Enabled = 1 and timer mbot_CurrentBotTargetUnableToAttackOverheadTimer >= mconfig_Target_UnableToAttackOverheadTimerCD and listexists mconfig_Target_UnableToAttackOverheadText
                                        foreach mbot_Overhead in mconfig_Target_UnableToAttackOverheadText
                                            if find mbot_CurrentBotTarget
                                                overhead mbot_Overhead mconfig_Target_UnableToAttackOverheadHue mbot_CurrentBotTarget
                                            endif
                                        endfor
                                        settimer mbot_CurrentBotTargetOverheadTimer 0
                                    endif
                                    @setvar! mbot_CurrentBotTarget 0
                                else
                                    settimer mbot_UsedSkillTimer 0
                                    @setvar! mbot_CurrentBotTargetAttacked 1
                                    @setvar! mbot_CurrentBotTargetGoodLOS 1
                                endif
                            endif
                        endif
                    endif

                    ##### Bard section end
                    if find mbot_CurrentBotTarget ground -1 -1 mbot_DynamicRangeCheck
                        // assume we got it
                        @setvar! mbot_CurrentBotTargetAttacked 1
                    elseif mbot_CurrentBotTargetGoodLOS = 1 and find mbot_CurrentBotTarget ground -1 -1 mbot_DynamicRangeCheck
                        @setvar! mbot_CurrentBotTargetAttacked 1
                    endif
                endif
            else
                @setvar! mbot_CurrentBotTarget 0
                @setvar! mbot_CurrentBotTargetGoodLOS 0
            endif
        endif
    elseif mconfig_Bot_FightAutoTarget = 1
        @setvar! mbot_CurrentBotTarget 0
        @setvar! mbot_CurrentBotTargetGoodLOS 0
        // do nothing
    elseif dead mbot_CurrentBotTarget
        @setvar! mbot_BOT_FIGHT 0
        @setvar! mbot_CurrentBotTarget 0
        @setvar! mbot_CurrentBotTargetGoodLOS 0
    endif
    
    ##### Out of Combat: Emergency AOE Peace (low health, not fighting)
    if mbot_BOT_FIGHT = 0 and hp < mconfig_Bard_AutoUseAoePeaceWhenLowHealthCheck and skill "Peacemaking" > 0 and timer mbot_UsedSkillTimer >= 5000
        while insysmsg "What instrument"
        endwhile
        useskill 'Peacemaking'
        wft 500
        if insysmsg "What instrument"
            target mbot_activeInstrument
            wft 500
        endif
        if targetexists 
            hotkey "Target Self"
            settimer mbot_UsedSkillTimer 0
        endif
    endif
    

    ##### Parry Codex Stance Switching (runs regardless of fight state)
    if skill "Parry" >= 80
        if mana >= mconfig_Parry_CodexMinMana and timer mbot_Parry_SwitchCodexTimer >= mbot_Parry_SwitchCodexTimerCD and findtype 11889 backpack as mbot_ParryCodex
            getlabel mbot_ParryCodex mbot_ParryCodexDesc

            if "Shield Bash" in mbot_ParryCodexDesc
                @setvar! mbot_ActiveParryCodex 1
            elseif "Warding" in mbot_ParryCodexDesc
                @setvar! mbot_ActiveParryCodex 2
            elseif "Testudo" in mbot_ParryCodexDesc
                @setvar! mbot_ActiveParryCodex 3
            elseif "Mirror" in mbot_ParryCodexDesc
                @setvar! mbot_ActiveParryCodex 4
            elseif "Bulwark" in mbot_ParryCodexDesc
                @setvar! mbot_ActiveParryCodex 5
            endif
            
            if findbuff "bleed" and mconfig_Parry_SwitchToWardingIfBleeding = 1 and diffhits >= mconfig_Parry_SwitchToWardingIfBleedingHpDiff
                @setvar! mbot_parryStanceTarget 2
            elseif findbuff "disease" and mconfig_Parry_SwitchToWardingIfDisease = 1 and diffhits >= mconfig_Parry_SwitchToWardingIfDiseaseHpDiff
                @setvar! mbot_parryStanceTarget 2
            elseif poisoned and mconfig_Parry_SwitchToWardingIfPoison = 1 and diffhits >= mconfig_Parry_SwitchToWardingIfPoisonHpDiff
                @setvar! mbot_parryStanceTarget 2
            elseif mconfig_Parry_SwitchToBulwarkIfStandingStill = 1 and not cooldown "Bulwark"
                @setvar! mbot_parryStanceTarget 5
            elseif mconfig_Parry_SwitchToShieldBashWhileMoving = 1 and cooldown "Moving"
                @setvar! mbot_parryStanceTarget 1
            else
                @setvar! mbot_parryStanceTarget mconfig_Parry_SwitchToDefaultStance
            endif
            
            if mbot_ActiveParryCodex != mbot_parryStanceTarget
                if mbot_parryStanceTarget = 1
                    say "[ShieldsStance1"
                elseif mbot_parryStanceTarget = 2
                    say "[ShieldsStance2"
                elseif mbot_parryStanceTarget = 3
                    say "[ShieldsStance3"
                elseif mbot_parryStanceTarget = 4
                    say "[ShieldsStance4"
                elseif mbot_parryStanceTarget = 5
                    say "[ShieldsStance5"
                endif
                settimer mbot_Parry_SwitchCodexTimer 0
            endif
        endif
    endif

    ##### Post-Attack Actions (this iteration only, if we attacked)
    if mbot_CurrentBotTargetAttacked = 1

        if mconfig_Healing_AidCountAlertLessThan20 = 1 and skill "Healing" > 0 and counttype 3617 self as mbot_BOT_AidCount
            if 20 > mbot_BOT_AidCount
            overhead "We are low on aids {{mbot_BOT_AidCount}}" 34
            endif
        endif
    
        ##### Post-Attack: Cleansing Brew
        if mconfig_Potion_UseCleansingBrewAutomatically = 1 and findtype 50675 backpack 2935 as mbot_UseItem
            if findbuff "bleed" or findbuff "disease"
                if diffhits >= mconfig_Potion_CleansingBrewHpDiffTrigger
                    dclick mbot_UseItem
                    cooldown "Cleansing Brew" mbot_UseCleansingBrewTimerCD
                    settimer mbot_UseCleansingBrewTimer 0
                endif
            endif
        endif
    
        ##### Post-Attack: Weapon Abilities
        if mconfig_Weapon_UseAbility1 = 1 and timer mbot_UseAbilityTimer >= mconfig_Weapon_UseAbilityTimerCD
            while insysmsg "You do cannot perform that ability yet." or insysmsg "You have not yet unlocked that weapon ability." or insysmsg "You do not have the required codex or skills to use that weapon ability."
            endwhile
            say "[WeaponAbility1"
            settimer mbot_UseAbilityTimer 0 
        elseif mconfig_Weapon_UseAbility2 = 1 and timer mbot_UseAbilityTimer >= mconfig_Weapon_UseAbilityTimerCD
            while insysmsg "You do cannot perform that ability yet." or insysmsg "You have not yet unlocked that weapon ability." or insysmsg "You do not have the required codex or skills to use that weapon ability."
            endwhile
            say "[WeaponAbility2"
            settimer mbot_UseAbilityTimer 0 
        elseif mconfig_Weapon_UseAbility3 = 1 and timer mbot_UseAbilityTimer >= mconfig_Weapon_UseAbilityTimerCD
            while insysmsg "You do cannot perform that ability yet." or insysmsg "You have not yet unlocked that weapon ability." or insysmsg "You do not have the required codex or skills to use that weapon ability."
            endwhile 
            say "[WeaponAbility3"
            settimer mbot_UseAbilityTimer 0 
        endif   
            
        ##### Post-Attack: Explosion Pot
        if not queued and mconfig_Potion_AutoExplodePot = 1 and find mbot_CurrentBotTarget ground -1 -1 8 and findtype 3853 self 0 as mbot_explosionPot
            if timer mbot_AutoExplodePotTimer >= mbot_AutoExplodePotTimerCD and timer mbot_UseItemTimer >= mbot_UseItemTimerCD
                @ignore mbot_explosionPot
                dclick mbot_explosionPot
                settimer mbot_UseItemTimer 0
                getlabel mbot_explosionPot mbot_explosionPotDesc    
                if "next" in mbot_explosionPotDesc
                    if "12 seconds" in mbot_explosionPotDesc
                        @setvar! mbot_AutoExplodePotTimerCD 12000
                    elseif "13 seconds" in mbot_explosionPotDesc
                        @setvar! mbot_AutoExplodePotTimerCD 13000
                    elseif "14 seconds" in mbot_explosionPotDesc
                        @setvar! mbot_AutoExplodePotTimerCD 14000
                    elseif "15 seconds" in mbot_explosionPotDesc
                        @setvar! mbot_AutoExplodePotTimerCD 15000
                    endif
                    settimer mbot_AutoExplodePotTimer 0
                    cooldown "Purple Pot" mbot_AutoExplodePotTimerCD
                endif
                while insysmsg "Target cannot be seen"
                    overhead "clearing the target cannot be seen"
                endwhile
                wft 500
                target mbot_CurrentBotTarget
                getlabel backpack mbot_PingCheck
                if insysmsg "Target cannot be seen"
                    while timer mbot_UseItemTimer < mbot_UseItemTimerCD
                    endwhile
                    dclick mbot_explosionPot
                    wft 500
                endif
                if targetexists and findtype 3853 backpack -1 1 1 as mbot_nextExplosionPot
                    overhead "YEETING POTION" 89
                    target mbot_nextExplosionPot
                endif
                @unignore mbot_explosionPot
            endif
        endif
    
        ##### Post-Attack: Buff Potions & Chivalry Gate C
        if not queued and mconfig_Potion_UseAgilityAutomatically = 1 and not findbuff "Agility" and findtype 3848 self as mbot_Potion
            if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
                dclick mbot_Potion
                settimer mbot_UseItemTimer 0
            endif
        endif
        
        if not queued and mconfig_Potion_UseStrengthAutomatically = 1 and not findbuff "Strength" and findtype 3849 self as mbot_Potion
            if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
                dclick mbot_Potion
                settimer mbot_UseItemTimer 0
            endif
        endif
        
        if not queued and mconfig_Potion_UseMagicResistAutomatically = 1 and not findbuff "Magic Resist" and findtype 3846 self as mbot_Potion
            if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
                dclick mbot_Potion
                settimer mbot_UseItemTimer 0
            endif
        elseif not queued and mconfig_Potion_UseMagicResistAgainIfDebuffedAutomatically = 1 and findbuff "Magic Resist Decrease" and findtype 3846 self as mbot_Potion
            if timer mbot_UseItemTimer >= mbot_UseItemTimerCD
                dclick mbot_Potion
                settimer mbot_UseItemTimer 0
            endif
        endif


        ##### Chivalry Gate C - Divine Fury / Enemy of One / Consecrate Weapon (respects reserve, combat only)
        if varexist mbot_HolySymbols

            @setvar! mbot_divineFuryIsUsed 0
            if mconfig_Chiv_UseDivineFuryAutomatically = 0
                @setvar! mbot_divineFuryIsUsed 1
            elseif mconfig_Chiv_UseDivineFuryAutomatically = 1 and timer mbot_DivineFuryTimer < mbot_DivineFuryTimerCD
                @setvar! mbot_divineFuryIsUsed 1
            endif
        
            if mconfig_Chiv_UseDivineFuryAutomatically = 1 and mconfig_Chiv_MinSymbolsDivineFury <= mbot_HolySymbols and skill "chivalry" >= 85 and timer mbot_DivineFuryTimer >= mbot_DivineFuryTimerCD
                while insysmsg "Holy symbols remaining"
                endwhile
                say "[DivineFury"
                getlabel backpack mbot_PingCheck
                if insysmsg "Holy symbols remaining"
                    cooldown "Divine Fury" mbot_DivineFuryTimerCD
                    settimer mbot_DivineFuryTimer 0
                    settimer mbot_Chiv_SymbolCheckTimer mbot_Chiv_SymbolCheckTimerCD
                endif
            elseif mbot_divineFuryIsUsed = 1 and mconfig_Chiv_UseEnemyOfOneAutomatically = 1 and mconfig_Chiv_MinSymbolsEnemyOfOne <= mbot_HolySymbols and skill "chivalry" >= 75 and timer mbot_EnemyOfOneTimer >= mbot_EnemyOfOneTimerCD
                while insysmsg "Holy symbols remaining"
                endwhile
                say "[EnemyOfOne"
                getlabel backpack mbot_PingCheck
                if insysmsg "Holy symbols remaining" 
                    cooldown "Enemy Of One" mbot_EnemyOfOneTimerCD
                    settimer mbot_EnemyOfOneTimer 0
                    settimer mbot_Chiv_SymbolCheckTimer mbot_Chiv_SymbolCheckTimerCD
                endif  
            elseif mbot_divineFuryIsUsed = 1 and mconfig_Chiv_UseConsecrateWeaponAutomatically = 1 and mconfig_Chiv_MinSymbolsConsecrateWeapon <= mbot_HolySymbols and skill "chivalry" >= 65 and timer mbot_ConsecrateWeaponTimer >= mbot_ConsecrateWeaponTimerCD
                while insysmsg "Holy symbols remaining"
                endwhile
                say "[ConsecrateWeapon"
                getlabel backpack mbot_PingCheck
                if insysmsg "Holy symbols remaining" 
                    cooldown "Consecrate Weapon" mbot_ConsecrateWeaponTimerCD
                    settimer mbot_ConsecrateWeaponTimer 0
                    settimer mbot_Chiv_SymbolCheckTimer mbot_Chiv_SymbolCheckTimerCD
                endif
            endif
        endif
        
        ##### Post-Attack: Taunting
        if mconfig_Parry_AutoTaunting = 1 or mconfig_Parry_AutoAoeTaunting = 1
            @setvar! mbot_TriggerAbility 0
            if cooldown "Taunting" or timer mbot_TauntingTimer < mconfig_Parry_TauntingTimerCD
                // do nothing
            elseif diffhits <= mconfig_Parry_AutoTauntHpDiffTrigger
                @setvar! mbot_TriggerAbility 1
            endif
            if mbot_TriggerAbility = 1
                say "[Taunt"
                wft 500
                if targetexists 
                    while insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                    endwhile
                    if mconfig_Parry_AutoAoeTaunting = 1
                        hotkey "Target Self"
                    elseif find mbot_CurrentBotTarget
                        target mbot_CurrentBotTarget
                    endif
                    getlabel backpack mbot_PingCheck
                    if not targetexists 
                        if insysmsg "Cannot be seen"
                            // do nothing
                        else
                            cooldown "Taunting" mconfig_Parry_TauntingTimerCD
                            settimer mbot_TauntingTimer 0
                        endif
                    else
                        hotkey "Cancel Current Target"
                    endif
                endif
            endif
        endif
        
    endif
    
    ##### Out of Combat: Bard Passive Song-Buff Maintenance
    if mbot_BardDetected = 1

        if skill "Discordance" > 0
            if not findbuff "song of discordance" and timer mbot_BOT_BardBuffTimer >= 10000
                while insysmsg "What instrument"
                endwhile
                useskill 'Discordance'
                wft 500
                if insysmsg "What instrument"
                    target mbot_activeInstrument
                    wft 500
                endif
                target backpack
                settimer mbot_BOT_BardBuffTimer 0
            endif
        endif

        if skill "Provocation" > 0
            if not findbuff "song of provocation" and timer mbot_BOT_BardBuffTimer >= 10000
                while insysmsg "What instrument"
                endwhile
                useskill 'Provocation'
                wft 500
                if insysmsg "What instrument"
                    target mbot_activeInstrument
                    wft 500
                endif
                target backpack
                settimer mbot_BOT_BardBuffTimer 0
            endif
        endif

        if skill "Peacemaking" > 0
            if not findbuff "song of peacemaking" and timer mbot_BOT_BardBuffTimer >= 10000
                while insysmsg "What instrument"
                endwhile
                useskill 'Peacemaking'
                wft 500
                if insysmsg "What instrument"
                    target mbot_activeInstrument
                    wft 500
                endif
                target backpack
                settimer mbot_BOT_BardBuffTimer 0
            endif
        endif

    endif

    wait 10
endwhile