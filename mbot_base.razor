#####
### Taming (crook activation, "all guard me" timer setup)
if jaseowns_TamerDetected = 1

    if not varexist myAwesomeCrookThatIsActivated
        @setvar! myAwesomeCrookThatIsActivated 0
    endif
    if not find myAwesomeCrookThatIsActivated self
        if skill "Herding" > 0 and findtype 3713 self as firstJrook
            @setvar! isHerdingActive 0
            while isHerdingActive = 0
                if counttype 3713 self > 1
                    @clearignore
                    while findtype 3713 self as jrook
                        getlabel jrook multiDesc
                        if 'activated' in multiDesc
                            @setvar! isHerdingActive jrook
                            break
                        endif
                        @ignore jrook
                    endwhile
                    @clearignore
                    if isHerdingActive = 0
                        dclick firstJrook
                    endif
                endif

                if isHerdingActive = 0
                    getlabel firstJrook desc
                    if 'activated' in desc
                        @setvar! isHerdingActive firstJrook
                    else
                        dclick firstJrook
                        getlabel firstJrook desc
                        @setvar! isHerdingActive firstJrook
                    endif
                endif
            endwhile
            @setvar! myAwesomeCrookThatIsActivated isHerdingActive
        endif
    endif

    if mconfig_Taming_SayAllGuard = 1

        if not varexist mconfig_Taming_SayAllGuardTimerCD
            @setvar! mconfig_Taming_SayAllGuardTimerCD 9000
        endif

        if not timerexists jaseowns_Tamer_SayAllGuardTimer
            settimer jaseowns_Tamer_SayAllGuardTimer mconfig_Taming_SayAllGuardTimerCD
        endif

    endif

endif

@setvar! jaseowns_BandageTimerCD 20000
if not timerexists jaseowns_BandageTimer
    settimer jaseowns_BandageTimer jaseowns_BandageTimerCD
endif


@setvar! jaseowns_RedPouchCountTotal 0


while not dead

    while insysmsg "You deliver a poison sting"
        cooldown "Poison Sting" 5000
    endwhile

    // Handle manual bandage
    while insysmsg "You begin applying" or insysmsg "You begin using veterinary supplies"
        settimer jaseowns_BandageTimer 0
    endwhile

    // Reset the timer if we finished
    while insysmsg "You finish applying" or insysmsg "You heal what little" or insysmsg "barely help" or insysmsg "You fail to resurrect" or insysmsg "You are able to resurrect" or insysmsg "You finish using veterinary supplies" or insysmsg "You or your nearby followers do not require healing"
        settimer jaseowns_BandageTimer jaseowns_BandageTimerCD
    endwhile
    
    if skill "Healing" > 0 and findtype 3617 self 
        if timer jaseowns_BandageTimer >= jaseowns_BandageTimerCD and not targetexists
            // and not queued
            if poisoned or findbuff "disease" or findbuff "bleed"
                hotkey "Bandage Self"
            elseif not varexist mconfig_Healing_AutoBandageHpDiffTrigger
                if hp < maxhp
                    hotkey "Bandage Self"
                endif
            elseif diffhits > mconfig_Healing_AutoBandageHpDiffTrigger 
                hotkey "Bandage Self"
            endif
            getlabel backpack jaseowns_PingCheck
            if insysmsg "You begin applying"
                settimer jaseowns_BandageTimer 0
            endif
        endif
    endif
    
    if mconfig_Thief_AlertRedPouchPop = 1 and counttype 3705 backpack 38 as jaseowns_RedPouchCount
        if jaseowns_RedPouchCountTotal != 0 and jaseowns_RedPouchCountTotal != jaseowns_RedPouchCount
            overhead "Warning: THIEF we lost a pouch!" 34
        else
            @setvar! jaseowns_RedPouchCountTotal jaseowns_RedPouchCount    
        endif
    endif

    if casting 
        settimer jaseowns_UseItemTimer 0
    endif

    if not queued and find jaseowns_BOT_CurrentRightHandWeapon backpack and timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
        if findlayer self righthand as jaseowns_RightHandWeapon
            @setvar! jaseowns_BOT_CurrentRightHandWeapon jaseowns_RightHandWeapon
        else
            dclick jaseowns_BOT_CurrentRightHandWeapon
            settimer jaseowns_UseItemTimer 0
        endif
    elseif not queued and find jaseowns_BOT_CurrentLeftHandWeapon backpack and timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
        if findlayer self lefthand as jaseowns_LeftHandWeapon
            @setvar! jaseowns_BOT_CurrentLeftHandWeapon jaseowns_LeftHandWeapon
        else
            dclick jaseowns_BOT_CurrentLeftHandWeapon
            settimer jaseowns_UseItemTimer 0
        endif
    endif
    
    if jaseowns_TamerDetected = 1
        if mconfig_Taming_SayAllGuard = 1 and followers > 0
            if timer jaseowns_Tamer_SayAllGuardTimer >= mconfig_Taming_SayAllGuardTimerCD
                say "all guard me" 89
                settimer jaseowns_Tamer_SayAllGuardTimer 0
            endif
        endif
    endif
    if skill "Poisoning" >= 50 and mconfig_Poison_AutomaticallyApply = 1
        if counttype 3850 jaseowns_PotionSatchel or counttype 3850 backpack
            @setvar! weapon_to_poison 0
            if findlayer self righthand as jaseowns_RightHandWeapon
                @setvar! weapon_to_poison jaseowns_RightHandWeapon
                @setvar! jaseowns_BOT_CurrentRightHandWeapon jaseowns_RightHandWeapon
            endif
            if weapon_to_poison != 0
                getlabel weapon_to_poison weapon_to_poisonDesc
                if timer poison_display_timer >= poison_display_timer_cd
                    overhead "{{weapon_to_poisonDesc}}" 72
                    settimer poison_display_timer 0
                endif
                if timer poison_check_timer >= poison_check_timer_cd and timer poison_reapply_timer <= poison_reapply_timer_cd
                    settimer poison_check_timer 0                    
                    if "poison charge" in weapon_to_poisonDesc
                        foreach reapply_text in poison_check_list
                            if reapply_text in weapon_to_poisonDesc
                                overhead "Need to reapply poison: {{reapply_text}}.XX charges remain"
                                settimer poison_reapply_timer poison_failed_timer_cd
                            endif                        
                        endfor                          
                    else
                        overhead "Weapon not poisoned, applying poison {{weapon_to_poisonDesc}}" 34
                        settimer poison_reapply_timer poison_failed_timer_cd
                    endif
                endif
                if insysmsg "You fail to apply a sufficient dose of poison." or insysmsg "grave mistake while"
                    overhead "Failed to apply Poison" 72     
                    settimer poison_reapply_timer poison_failed_timer_cd               
                elseif insysmsg "You apply the poison." 
                    overhead "Poison applied!" 72
                    settimer poison_reapply_timer 0
                endif
                if timer poison_reapply_timer >= poison_apply_timer_cd
                    overhead "Applying Poison" 72
                    menu weapon_to_poison 0
                    settimer poison_check_timer 0
                    settimer poison_reapply_timer poison_reapply_timer_cd
                endif
            endif
        else
            overhead "Out of poison pots!" 34
        endif
    endif

    if varexist mconfig_Weight_GoldToDropIfOverweight and weight > maxweight and timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
        if findtype "gold coin" backpack as item
            while insysmsg "cannot drop anything"
            endwhile
            lift item mconfig_Weight_GoldToDropIfOverweight
            droprelloc 0 0
            getlabel backpack jaseowns_PingCheck
            if insysmsg "cannot drop anything"
                drop backpack -1 -1 -1
            endif
            settimer jaseowns_UseItemTimer 0
        else
            overhead "We are overweight and cannot drop anything" 34
        endif
    endif
    
    if mconfig_Potion_ShowOverheads = 1
    
        if timer jaseowns_Potion_Cure_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_CureOverheadIfCountIsLessThanTimerCD
            @setvar! jaseowns_BOT_CurePotionCount 0
            if counttype 3847 jaseowns_PotionSatchel as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_CurePotionCount jaseowns_TempPotionCount
            elseif counttype 3847 backpack as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_CurePotionCount jaseowns_TempPotionCount
            endif
            if jaseowns_BOT_CurePotionCount < mconfig_Potion_CureOverheadIfCountIsLessThan
                if jaseowns_BOT_CurePotionCount = 0
                    overhead "Cure: Out of cures" 34
                else
                    overhead "Cures Remaining: {{jaseowns_BOT_CurePotionCount}}"
                endif
            endif
            settimer jaseowns_Potion_Cure_Overhead_IfCountIsLessThan_Timer 0
        endif
        
        if timer jaseowns_Potion_Heal_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_HealOverheadIfCountIsLessThanTimerCD
            @setvar! jaseowns_BOT_HealPotionCount 0
            if counttype 3852 jaseowns_PotionSatchel as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_HealPotionCount jaseowns_TempPotionCount
            elseif counttype 3852 backpack as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_HealPotionCount jaseowns_TempPotionCount
            endif
            if jaseowns_BOT_HealPotionCount < mconfig_Potion_HealOverheadIfCountIsLessThan
                if jaseowns_BOT_HealPotionCount = 0
                    overhead "Heal: Out of heals" 34
                else
                    overhead "Heal Remaining: {{jaseowns_BOT_HealPotionCount}}"
                endif
            endif
            settimer jaseowns_Potion_Heal_Overhead_IfCountIsLessThan_Timer 0
        endif
        
        if timer jaseowns_Potion_Explosion_Overhead_IfCountIsLessThan_Timer >= mconfig_Potion_ExplosionOverheadIfCountIsLessThanTimerCD
            @setvar! jaseowns_BOT_ExplosionPotionCount 0
            if counttype 3853 jaseowns_PotionSatchel as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_ExplosionPotionCount jaseowns_TempPotionCount
            elseif counttype 3853 backpack as jaseowns_TempPotionCount
                @setvar! jaseowns_BOT_ExplosionPotionCount jaseowns_TempPotionCount
            endif
            if jaseowns_BOT_ExplosionPotionCount < mconfig_Potion_ExplosionOverheadIfCountIsLessThan
                if jaseowns_BOT_ExplosionPotionCount = 0
                    overhead "Explosion: Out of explosions" 34
                else
                    overhead "Explosion Remaining: {{jaseowns_BOT_ExplosionPotionCount}}"
                endif
            endif
            settimer jaseowns_Potion_Explosion_Overhead_IfCountIsLessThan_Timer 0
        endif
        
    endif

    if not queued and not findbuff "food" and findtype "tray" backpack as jaseowns_FoodItem
        if timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
            dclick jaseowns_FoodItem
            settimer jaseowns_UseItemTimer 0
        endif
    endif
    
    if mconfig_Potion_HasPanacea = 1 and timer jaseowns_UsePanaceaTimer >= jaseowns_UsePanaceaTimerCD
        if findbuff "bleed" or findbuff "disease"
            if findtype 3847 self 0 as jaseowns_UseItem
                dclick jaseowns_UseItem
                cooldown "Panacea" jaseowns_UsePanaceaTimerCD
                settimer jaseowns_UsePanaceaTimer 0
            endif
        endif
    endif
    
    # Potions
    if not queued and mconfig_Potion_UseCureAutomatically = 1 and poisoned and diffhits >= mconfig_Potion_CureHpDiffTrigger and findtype 3847 self as jaseowns_Potion
        if timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
            dclick jaseowns_Potion
            settimer jaseowns_UseItemTimer 0
        endif
    endif
    
    if mconfig_Potion_UseHealAutomatically = 1 and diffhits >= mconfig_Potion_HealHpDiffTrigger and findtype 3852 self as jaseowns_Potion
        if timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
            getlabel jaseowns_Potion jaseowns_PotionDesc
            if "next usable in" in jaseowns_PotionDesc
                // do nothing
            else
                dclick jaseowns_Potion
                settimer jaseowns_UseItemTimer 0
            endif
        endif
    endif

    if not queued and mconfig_Potion_UseRefreshAutomatically = 1 and diffstam >= mconfig_Potion_RefreshStamDiffTrigger and findtype 3851 self as jaseowns_Potion
        if timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD
            dclick jaseowns_Potion
            settimer jaseowns_UseItemTimer 0
        endif
    endif
    
    // Trapped
    if paralyzed and not queued 
        if findtype "pouch" backpack 38 
            yell "[pouch"
            getlabel backpack jaseowns_PingCheck
        else
            overhead "Out of Pouches!" 34
        endif
    endif

    if not queued and mconfig_Skinning_UseKnifeAutomatically = 1 and findtype 11552 backpack as jaseowns_SkinningKnife
        if findbuff "Actively Meditating"
            //do nothing
        elseif findtype 8198 ground -1 -1 2 as jaseowns_Corpse
            while not targetexists 
                dclick jaseowns_SkinningKnife
                wft 500
            endwhile
            while targetexists 
                hotkey "Target Self"
                getlabel backpack jaseowns_PingCheck
            endwhile
            @ignore jaseowns_Corpse
        endif
    endif
    
    if skill "Tracking" > 0
        if not findbuff "tracking"
            while insysmsg "You will now hunt all hostile players."
            endwhile
            while not gumpexists 4267467659
                useskill 'tracking'
                getlabel backpack jaseowns_PingCheck
            endwhile
            if gumpexists 4267467659
                while not insysmsg "You will now hunt all hostile players."
                    gumpresponse 8 4267467659
                    waitforgump 4267467659 5000
                endwhile
                gumpresponse 6 4267467659
                getlabel backpack jaseowns_PingCheck
            endif
            gumpclose 4267467659
        endif
    endif
    
    if mconfig_Vet_UseKitsAutomatically = 1 and findtype 25750 backpack 0 as jaseowns_VetSupply
        if timer jaseowns_VET_UseVetSuppliesTimer >= mconfig_Vet_UseSuppliesTimerCD or hp < maxhp
            if timer jaseowns_UseItemTimer >= jaseowns_UseItemTimerCD and timer jaseowns_BandageTimer >= jaseowns_BandageTimerCD
                while insysmsg "You begin using veterinary supplies" or insysmsg "You or your nearby followers do not require healing"
                endwhile
                dclick jaseowns_VetSupply
                settimer jaseowns_UseItemTimer 0
                getlabel backpack jaseowns_PingCheck
                if insysmsg "You begin using veterinary supplies"
                    cooldown "Use Vet Supply" mconfig_Vet_UseSuppliesTimerCD
                    settimer jaseowns_VET_UseVetSuppliesTimer 0
                    settimer jaseowns_BandageTimer 0
                elseif insysmsg "You or your nearby followers do not require healing"
                    cooldown "Use Vet Supply" mconfig_Vet_UseSuppliesTimerCD
                    settimer jaseowns_VET_UseVetSuppliesTimer 0
                endif
            endif
        endif
    endif
    
    if timer jaseowns_Chiv_SymbolCheckTimer >= jaseowns_Chiv_SymbolCheckTimerCD
        if not gumpexists 1387930325 and skill "chivalry" >= 50
            say '[chivalryhotbar'
            waitforgump 1387930325 500
        endif
        if gumpexists 1387930325
            if cooldown PVP
                unsetvar jaseowns_HolySymbols
            elseif ingump "21/" 1387930325 or ingump "20/" 1387930325 or ingump "19/" 1387930325 or ingump "18/" 1387930325 or ingump "17/" 1387930325 or ingump "16/" 1387930325 or ingump "15/" 1387930325 or ingump "14/" 1387930325 or ingump "13/" 1387930325 or ingump "12/" 1387930325
                # 12+ symbols is always enough for these heals - cap here instead of tracking the exact count
                @setvar! jaseowns_HolySymbols 12
            elseif ingump "11/" 1387930325
                @setvar! jaseowns_HolySymbols 11
            elseif ingump "10/" 1387930325
                @setvar! jaseowns_HolySymbols 10
            elseif ingump "9/" 1387930325
                @setvar! jaseowns_HolySymbols 9
            elseif ingump "8/" 1387930325
                @setvar! jaseowns_HolySymbols 8
            elseif ingump "7/" 1387930325
                @setvar! jaseowns_HolySymbols 7
            elseif ingump "6/" 1387930325
                @setvar! jaseowns_HolySymbols 6
            elseif ingump "5/" 1387930325
                @setvar! jaseowns_HolySymbols 5
            elseif ingump "4/" 1387930325
                @setvar! jaseowns_HolySymbols 4
            elseif ingump "3/" 1387930325
                @setvar! jaseowns_HolySymbols 3
            elseif ingump "2/" 1387930325
                @setvar! jaseowns_HolySymbols 2
            elseif ingump "1/" 1387930325
                @setvar! jaseowns_HolySymbols 1
            elseif ingump "0/" 1387930325
                @setvar! jaseowns_HolySymbols 0
            endif
        endif
        settimer jaseowns_Chiv_SymbolCheckTimer 0
    endif

    ##### Chivalry Gate A - Noble Sacrifice / Holy Light (emergency heals, no reserve)
    if varexist jaseowns_HolySymbols

        @setvar! jaseowns_BOT_UseNobleSacrifice 0
        if mconfig_Chiv_UseNobleSacrificeAutomatically = 1 and skill "chivalry" >= 80 and timer jaseowns_NobleSacrificeTimer >= jaseowns_NobleSacrificeTimerCD
            if mconfig_Chiv_MinSymbolsNobleSacrifice <= jaseowns_HolySymbols
                if not varexist mconfig_Chiv_AutoUseNobleSacrificeHpDiffTrigger
                    if hp <= 30
                        @setvar! jaseowns_BOT_UseNobleSacrifice 1
                    endif
                elseif diffhits >= mconfig_Chiv_AutoUseNobleSacrificeHpDiffTrigger
                    @setvar! jaseowns_BOT_UseNobleSacrifice 1
                endif
            endif
        endif

        @setvar! jaseowns_BOT_UseHolyLight 0
        if mconfig_Chiv_UseHolyLightAutomatically = 1 and skill "chivalry" >= 95 and timer jaseowns_HolyLightTimer >= jaseowns_HolyLightTimerCD
            if mconfig_Chiv_MinSymbolsHolyLight <= jaseowns_HolySymbols
                if not varexist mconfig_Chiv_AutoHolyLightHpDiffTrigger
                    if hp <= 20
                        @setvar! jaseowns_BOT_UseHolyLight 1
                    endif
                elseif diffhits >= mconfig_Chiv_AutoHolyLightHpDiffTrigger
                    @setvar! jaseowns_BOT_UseHolyLight 1
                endif
            endif
        endif

        if jaseowns_BOT_UseNobleSacrifice = 1

            if targetexists
                hotkey "Clear Current Target"
            endif

            say "[NobleSacrifice"
            wft 500
            if targetexists
                while insysmsg "Holy symbols remaining"
                endwhile
                hotkey "Target Self"
                getlabel backpack jaseowns_PingCheck
                if not targetexists
                    if insysmsg "Holy symbols remaining"
                        cooldown "Noble Sacrifice" jaseowns_NobleSacrificeTimerCD
                        settimer jaseowns_NobleSacrificeTimer 0
                        settimer jaseowns_Chiv_SymbolCheckTimer jaseowns_Chiv_SymbolCheckTimerCD
                    endif
                else
                    hotkey "Cancel Current Target"
                endif
            endif
            if skill "Healing" > 0 and findtype 3617 self
                while insysmsg "You begin applying"
                endwhile
                hotkey "Bandage Self"
                getlabel backpack jaseowns_PingCheck
                if insysmsg "You begin applying"
                    settimer jaseowns_BandageTimer 0
                endif
            endif            
        elseif jaseowns_BOT_UseHolyLight = 1
            while insysmsg "Holy symbols remaining"
            endwhile
            say "[HolyLight"
            getlabel backpack jaseowns_PingCheck
            if insysmsg "Holy symbols remaining"
                cooldown "Holy Light" jaseowns_HolyLightTimerCD
                settimer jaseowns_HolyLightTimer 0
                settimer jaseowns_Chiv_SymbolCheckTimer jaseowns_Chiv_SymbolCheckTimerCD
            endif
        endif

    endif

    ##### Chivalry Gate B - Close Wounds / Cleanse By Fire (respects reserve)
    if varexist jaseowns_HolySymbols

        @setvar! jaseowns_BOT_UseCloseWounds 0
        if findbuff "disease" or findbuff "bleed"
            if mconfig_Chiv_UseCloseWoundsAutomatically = 1 and mconfig_Chiv_MinSymbolsCloseWounds <= jaseowns_HolySymbols and skill "chivalry" >= 70 and timer jaseowns_CloseWoundsTimer >= jaseowns_CloseWoundsTimerCD
                if not varexist mconfig_Chiv_AutoCloseWoundHpDiffTrigger
                    if diffhits >= 5
                        @setvar! jaseowns_BOT_UseCloseWounds 1
                    endif
                elseif diffhits >= mconfig_Chiv_AutoCloseWoundHpDiffTrigger
                    @setvar! jaseowns_BOT_UseCloseWounds 1
                endif
            endif
        endif

        @setvar! jaseowns_BOT_UseCleanseByFire 0
        if poisoned and mconfig_Chiv_UseCleanseByFireAutomatically = 1 and mconfig_Chiv_MinSymbolsCleanseByFire <= jaseowns_HolySymbols and skill "chivalry" >= 60 and timer jaseowns_CleanseByFireTimer >= jaseowns_CleanseByFireTimerCD
            @setvar! jaseowns_BOT_UseCleanseByFire 1
        endif

        if jaseowns_BOT_UseCloseWounds = 1
            while insysmsg "Holy symbols remaining"
            endwhile
            say "[CloseWounds"
            getlabel backpack jaseowns_PingCheck
            if insysmsg "Holy symbols remaining"
                cooldown "Close Wounds" jaseowns_CloseWoundsTimerCD
                settimer jaseowns_CloseWoundsTimer 0
                settimer jaseowns_Chiv_SymbolCheckTimer jaseowns_Chiv_SymbolCheckTimerCD
            endif
        elseif jaseowns_BOT_UseCleanseByFire = 1
            while insysmsg "Holy symbols remaining"
            endwhile
            say "[CleanseByFire"
            getlabel backpack jaseowns_PingCheck
            if insysmsg "Holy symbols remaining"
                cooldown "Cleanse By Fire" jaseowns_CleanseByFireTimerCD
                settimer jaseowns_CleanseByFireTimer 0
                settimer jaseowns_Chiv_SymbolCheckTimer jaseowns_Chiv_SymbolCheckTimerCD
            endif
        endif

    endif

    @setvar! jaseowns_CurrentBotTargetAttacked 0

    
    if mconfig_Bot_FightAutoTarget = 1
        @setvar! jaseowns_BOT_FIGHT 0
        if mconfig_Bot_FightInPeaceMode = 1
            if not warmode
                @setvar! jaseowns_BOT_FIGHT 1
            endif
        elseif warmode
            @setvar! jaseowns_BOT_FIGHT 1
        endif
    else
        
        if insysmsg "Target a new 'Last Target'"
            overhead "Set your target"
            while targetexists 
                wait 50
            endwhile
            getlabel backpack jaseowns_PingCheck
            if insysmsg "Last Target set."
                overhead "New target selected!" 89 lasttarget
                @setvar! jaseowns_CurrentBotTarget lasttarget 
                @setvar! jaseowns_BOT_FIGHT 1
            endif
        endif
    
        if insysmsg "New Target Set"
            while insysmsg "New Target Set"
            endwhile
            overhead "New target selected!" 89 lasttarget
            @setvar! jaseowns_CurrentBotTarget lasttarget 
            @setvar! jaseowns_BOT_FIGHT 1
        endif
        
        if dead jaseowns_CurrentBotTarget
            @setvar! jaseowns_BOT_FIGHT 0
        endif
    endif

    if jaseowns_BOT_FIGHT = 1 and not cooldown PVP
        
        if insysmsg "Target a new 'Last Target'"
            overhead "Set your target"
            while targetexists 
                wait 50
            endwhile
            getlabel backpack jaseowns_PingCheck
            if insysmsg "Last Target set."
                overhead "New target selected!" 89 lasttarget
                @setvar! jaseowns_CurrentBotTarget lasttarget 
            endif
        endif
        
        // do fighting
        if not find jaseowns_CurrentBotTarget and mconfig_Bot_FightAutoTarget = 1
            @setvar! jaseowns_BARD_PROVO_COUNTER 0
            hotkey "target closest non-friendly monster"
            @setvar! jaseowns_LastBotTarget lasttarget 
            if jaseowns_CurrentBotTarget != jaseowns_LastBotTarget
                @setvar! jaseowns_CurrentBotTarget jaseowns_LastBotTarget
            endif
        endif
        
        if not dead jaseowns_CurrentBotTarget
            if noto jaseowns_CurrentBotTarget = "friend" or noto jaseowns_CurrentBotTarget = "innocent" or noto jaseowns_CurrentBotTarget = "invulnerable"
                @setvar! jaseowns_CurrentBotTarget 0
            elseif noto jaseowns_CurrentBotTarget = "murderer" or noto jaseowns_CurrentBotTarget = "enemy"
                // figure out if we want to change this
                //@setvar! jaseowns_CurrentBotTarget 0
            elseif noto jaseowns_CurrentBotTarget = "hostile" or noto jaseowns_CurrentBotTarget = "criminal"
                // good to go
            else
                @setvar! jaseowns_CurrentBotTarget 0
            endif
        endif
        
        # TODO: handle hidden mobs
        if not dead jaseowns_CurrentBotTarget
            
        
            if timer jaseowns_CurrentBotTargetOverheadTimer >= mconfig_Target_CurrentOverheadTimerCD and listexists mconfig_Target_CurrentOverheadText
                foreach jaseowns_Overhead in mconfig_Target_CurrentOverheadText
                    if find jaseowns_CurrentBotTarget
                        overhead jaseowns_Overhead mconfig_Target_CurrentOverheadHue jaseowns_CurrentBotTarget
                    endif
                endfor
                settimer jaseowns_CurrentBotTargetOverheadTimer 0
            endif

            if find jaseowns_CurrentBotTarget ground -1 -1 jaseowns_FightingRangeCheck
                
                for 3
                    if dead jaseowns_CurrentBotTarget
                        break
                    endif
                    getlabel jaseowns_CurrentBotTarget jaseowns_CurrentBotTargetDesc
                    if "-" in jaseowns_CurrentBotTargetDesc
                        // do nothing - try again
                    else
                        break
                    endif
                endfor
                
                @setvar! jaseowns_IgnoreCurrentBotTarget 0
                
                if "(summoned" in jaseowns_CurrentBotTargetDesc or "(bonded" in jaseowns_CurrentBotTargetDesc or "(tame" in jaseowns_CurrentBotTargetDesc
                    overhead "▼ Player pet - IGNORE ▼" 77 jaseowns_CurrentBotTarget
                    @setvar! jaseowns_IgnoreCurrentBotTarget 1
                elseif listexists mconfig_Target_IgnoreMobList
                    foreach jaseowns_IgnoreMob in mconfig_Target_IgnoreMobList
                        if jaseowns_IgnoreMob in jaseowns_CurrentBotTargetDesc
                            if timer jaseowns_IgnoreMobOverheadTimer >= mconfig_Target_IgnoreMobOverheadTimerCD and listexists mconfig_Target_IgnoreMobOverheadText
                                foreach jaseowns_Overhead in mconfig_Target_IgnoreMobOverheadText
                                    if find jaseowns_CurrentBotTarget
                                        overhead jaseowns_Overhead mconfig_Target_IgnoreMobOverheadHue  jaseowns_CurrentBotTarget
                                    endif
                                endfor
                                settimer jaseowns_IgnoreMobOverheadTimer 0
                            endif
                            @setvar! jaseowns_IgnoreCurrentBotTarget 1
                        endif
                    endfor
                endif

                if jaseowns_IgnoreCurrentBotTarget = 1 or dead jaseowns_CurrentBotTarget
                    @setvar! jaseowns_CurrentBotTarget 0
                else
                    

                    attack jaseowns_CurrentBotTarget
                
                    if cooldown "Bard Reset"
                        settimer jaseowns_UsedSkillTimer 5000
                        cooldown "Bard Reset" 0
                    endif
                    
                    @setvar! jaseowns_BOT_TargetPoisoned 0
                    if "Ticks" in jaseowns_CurrentBotTargetDesc
                        if "[3" in jaseowns_CurrentBotTargetDesc or "[4" in jaseowns_CurrentBotTargetDesc or "[5" in jaseowns_CurrentBotTargetDesc or "[6" in jaseowns_CurrentBotTargetDesc or "[7" in jaseowns_CurrentBotTargetDesc or "[8" in jaseowns_CurrentBotTargetDesc or "[9" in jaseowns_CurrentBotTargetDesc or "[10" in jaseowns_CurrentBotTargetDesc
                            @setvar! jaseowns_BOT_TargetPoisoned 1
                        endif
                    endif
                    
                    @setvar! jaseowns_Bard_SkipPeace 0
                    if "pacified" in jaseowns_CurrentBotTargetDesc
                        @setvar! jaseowns_Bard_SkipPeace 1
                    endif

                    if "provo" in jaseowns_CurrentBotTargetDesc
                        @setvar! jaseowns_Bard_SkipPeace 1
                    endif
                    
                    @setvar! jaseowns_Bard_SkipDiscord 0
                    if mconfig_Bard_UsePeaceFirst = 1 and jaseowns_Bard_SkipPeace = 0
                        @setvar! jaseowns_Bard_SkipDiscord 1
                    elseif "discord" in jaseowns_CurrentBotTargetDesc
                        @setvar! jaseowns_Bard_SkipDiscord 1
                    endif
                    
                    # TODO: longshot bro
                    if findtype 5117|3920|31184|31186|30993|31172|31169|9917 righthand or findtype 5117|3920|31184|31186|30993 lefthand
                        @setvar! jaseowns_DynamicRangeCheck 8
                    elseif findtype 30994|30990|30995|5042 lefthand
                        @setvar! jaseowns_DynamicRangeCheck 10
                    else
                        @setvar! jaseowns_DynamicRangeCheck 2
                    endif
                    
                    @setvar! jaseowns_Bard_DiscordCheckNextMob 0
                    
                    # PROVO
                    if jaseowns_Bard_CanProvo = 1 and timer jaseowns_UsedSkillTimer >= 5000

                        if jaseowns_BARD_PROVO_COUNTER = 4
                            // do nothing
                        else
                            @setvar! jaseowns_Bard_SkipDiscord 1
                            @setvar! jaseowns_Bard_SkipPeace 1
                        endif
                    
                        if not targetexists and timer jaseowns_BARD_TARGET_RANGECHECK_TIMER >= jaseowns_BARD_TARGET_RANGECHECK_TIMERCD
                                
                            if not find jaseowns_BARD_TARGET1 and find jaseowns_CurrentBotTarget ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                @setvar! jaseowns_BARD_TARGET1 jaseowns_CurrentBotTarget
                            endif
                            
                            if jaseowns_BARD_TARGET1 = jaseowns_BARD_TARGET2
                                @setvar! jaseowns_BARD_TARGET2 0
                            endif
                            
                            if find jaseowns_BARD_TARGET1 ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK and find jaseowns_BARD_TARGET2 ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                
                                for 3
                                    if dead jaseowns_BARD_TARGET1
                                        break
                                    endif
                                    getlabel jaseowns_BARD_TARGET1 jaseowns_CurrentBotTargetDesc1
                                    if "-" in jaseowns_CurrentBotTargetDesc1
                                        // do nothing - try again
                                    else
                                        break
                                    endif
                                endfor
                                
                                for 3
                                    if dead jaseowns_BARD_TARGET2
                                        break
                                    endif
                                    getlabel jaseowns_BARD_TARGET2 jaseowns_CurrentBotTargetDesc2
                                    if "-" in jaseowns_CurrentBotTargetDesc2
                                        // do nothing - try again
                                    else
                                        break
                                    endif
                                endfor
                                
                                while insysmsg "Target cannot be seen"
                                endwhile
                                
                                if "provo" in jaseowns_CurrentBotTargetDesc1 and "provo" in jaseowns_CurrentBotTargetDesc2
                                    if "discord" in jaseowns_CurrentBotTargetDesc2
                                        // do nothing
                                    else
                                        @setvar! jaseowns_Bard_DiscordCheckNextMob jaseowns_BARD_TARGET2
                                    endif
                                    @setvar! jaseowns_BARD_TARGET2 0
                                else
                                    @setvar! jaseowns_BARD_PROVO_COUNTER 0
                                    while insysmsg "What instrument"
                                    endwhile
                                    useskill "Provocation" 
                                    wft 500
                                    if insysmsg "What instrument"
                                        if findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as jaseowns_Instrument 
                                            target jaseowns_Instrument
                                            @setvar! jase_MyInny jaseowns_Instrument
                                        else
                                            overhead "I do not have an instrument" 34
                                        endif
                                        wft 500
                                    endif
                                    if targetexists
                                        target jaseowns_BARD_TARGET1
                                        getlabel backpack jaseowns_PingCheck
                                        if insysmsg "Target cannot be seen"
                                            @setvar! jaseowns_BARD_TARGET1 0
                                        else
                                            wft 500
                                            target jaseowns_BARD_TARGET2
                                            getlabel backpack jaseowns_PingCheck                
                                            if insysmsg "Target cannot be seen"
                                                @setvar! jaseowns_BARD_TARGET2 0
                                            endif
                                        endif
                                    endif
                                endif
                            
                            else
                                
                    
                                if jaseowns_BARD_PROVO_COUNTER = 0
                                    @setvar! jaseowns_BARD_PROVO_COUNTER 1
                                elseif jaseowns_BARD_PROVO_COUNTER = 1
                                    @setvar! jaseowns_BARD_PROVO_COUNTER 2
                                elseif jaseowns_BARD_PROVO_COUNTER = 2
                                    @setvar! jaseowns_BARD_PROVO_COUNTER 3
                                else
                                    @setvar! jaseowns_BARD_PROVO_COUNTER 4
                                endif
                            
                                if not find jaseowns_BARD_TARGET1 and find jaseowns_CurrentBotTarget ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                    @setvar! jaseowns_BARD_TARGET1 jaseowns_CurrentBotTarget
                                endif
                            
                                if find jaseowns_BARD_TARGET1 ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                    // check for second one
                                    hotkey "target closest non-friendly monster"
                                    @setvar! jaseowns_LastBotTarget lasttarget 
                                    if jaseowns_BARD_TARGET1 != jaseowns_LastBotTarget
                                        for 3
                                            if dead jaseowns_BARD_TARGET2
                                                break
                                            endif
                                            getlabel jaseowns_BARD_TARGET2 jaseowns_CurrentBotTargetDesc
                                            if "-" in jaseowns_CurrentBotTargetDesc
                                                // do nothing - try again
                                            else
                                                break
                                            endif
                                        endfor
                                        if find jaseowns_LastBotTarget
                                            overhead "ATTEMPTING CLOSEST" 38 jaseowns_LastBotTarget
                                        endif
                                        if "provo" in jaseowns_CurrentBotTargetDesc
                                            // do nothing
                                        else
                                            @setvar! jaseowns_BARD_TARGET2 jaseowns_LastBotTarget    
                                        endif
                                    endif
                                    
                                    if not find jaseowns_BARD_TARGET2 ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                        
                                        @setvar! jaseowns_BARD_RANDOM_TARGET_OG 0
                                        hotkey "next non-friendly monster target"
                                        @setvar! jaseowns_BARD_RANDOM_TARGET lasttarget                     
                                        
                                        while find jaseowns_BARD_RANDOM_TARGET and jaseowns_BARD_RANDOM_TARGET != jaseowns_BARD_RANDOM_TARGET_OG
                                            if jaseowns_BARD_RANDOM_TARGET_OG = 0
                                                @setvar! jaseowns_BARD_RANDOM_TARGET_OG jaseowns_BARD_RANDOM_TARGET
                                            endif
                                            if not find jaseowns_BARD_TARGET1
                                                break
                                            endif
                                            
                                            if jaseowns_BARD_TARGET1 != jaseowns_BARD_RANDOM_TARGET and find jaseowns_BARD_RANDOM_TARGET ground -1 -1 jaseowns_BARD_TARGET_RANGECHECK
                                                for 3
                                                    if dead jaseowns_BARD_RANDOM_TARGET
                                                        break
                                                    endif
                                                    getlabel jaseowns_BARD_RANDOM_TARGET jaseowns_CurrentBotTargetDesc
                                                    if "-" in jaseowns_CurrentBotTargetDesc
                                                        // do nothing - try again
                                                    else
                                                        break
                                                    endif
                                                endfor
                                                
                                                if find jaseowns_BARD_RANDOM_TARGET
                                                    overhead "ATTEMPTING RANDOM" 34 jaseowns_BARD_RANDOM_TARGET
                                                endif
                                                
                                                if "provo" in jaseowns_CurrentBotTargetDesc
                                                    if "discord" in jaseowns_CurrentBotTargetDesc
                                                        // do nothing
                                                    else
                                                        @setvar! jaseowns_Bard_DiscordCheckNextMob jaseowns_BARD_RANDOM_TARGET
                                                    endif
                                                else
                                                    @setvar! jaseowns_BARD_TARGET2 jaseowns_BARD_RANDOM_TARGET    
                                                    break
                                                endif
                                            endif
                                            hotkey "next non-friendly monster target"
                                            @setvar! jaseowns_BARD_RANDOM_TARGET lasttarget                     
                                        endwhile
                                    endif
                                    settimer jaseowns_BARD_TARGET_RANGECHECK_TIMER 0
                                endif
                            endif
                        endif
                    else
                        # TODO: logic for people without provo
                        #  also do more discord checks (set a jaseowns_Bard_DiscordCheckNextMob)
                    endif
                    
                    
                    ### IN THE PROVO SECTION, TRY TO SET A LIST OF MOBS THAT ARE ALREADY PROVOED - SO YOU CAN KNOW WHAT TO DISCOR

                    if jaseowns_Bard_CanDiscord = 1 and not dead jaseowns_Bard_DiscordCheckNextMob
                        while insysmsg "What instrument"
                        endwhile
                        overhead "Discording Extra Mob: {{jaseowns_CurrentBotTargetDesc}}"
                        useskill 'Discordance'
                        wft 500
                        if insysmsg "What instrument"
                            if findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as jaseowns_Instrument 
                                target jaseowns_Instrument
                                @setvar! jase_MyInny jaseowns_Instrument
                            else
                                overhead "I do not have an instrument" 34
                            endif
                            wft 500
                        endif
                        if targetexists 
                            while insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                            endwhile
                            target jaseowns_Bard_DiscordCheckNextMob
                            getlabel backpack jaseowns_PingCheck
                            if insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                                if timer jaseowns_CurrentBotTargetUnableToAttackOverheadTimer >= mconfig_Target_UnableToAttackOverheadTimerCD and listexists mconfig_Target_UnableToAttackOverheadText
                                    foreach jaseowns_Overhead in mconfig_Target_UnableToAttackOverheadText
                                        if find jaseowns_CurrentBotTarget
                                            overhead jaseowns_Overhead mconfig_Target_UnableToAttackOverheadHue jaseowns_CurrentBotTarget
                                        endif
                                    endfor
                                    settimer jaseowns_CurrentBotTargetOverheadTimer 0
                                endif
                                @setvar! jaseowns_Bard_DiscordCheckNextMob 0
                            else
                                settimer jaseowns_UsedSkillTimer 0
                            endif
                        endif
                    
                    elseif jaseowns_Bard_CanDiscord = 1 and jaseowns_Bard_SkipDiscord = 0 and timer jaseowns_UsedSkillTimer >= 5000
                        while insysmsg "What instrument"
                        endwhile
                        overhead "Discording: {{jaseowns_CurrentBotTargetDesc}}"
                        useskill 'Discordance'
                        wft 500
                        if insysmsg "What instrument"
                            if findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as jaseowns_Instrument 
                                target jaseowns_Instrument
                                @setvar! jase_MyInny jaseowns_Instrument
                            else
                                overhead "I do not have an instrument" 34
                            endif
                            wft 500
                        endif
                        if targetexists 
                            while insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                            endwhile
                            target jaseowns_CurrentBotTarget
                            getlabel backpack jaseowns_PingCheck
                            if insysmsg "Target cannot be seen" or insysmsg "That is too far away."
                                if timer jaseowns_CurrentBotTargetUnableToAttackOverheadTimer >= mconfig_Target_UnableToAttackOverheadTimerCD and listexists mconfig_Target_UnableToAttackOverheadText
                                    foreach jaseowns_Overhead in mconfig_Target_UnableToAttackOverheadText
                                        if find jaseowns_CurrentBotTarget
