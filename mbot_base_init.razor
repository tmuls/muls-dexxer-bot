@setvar! mconfig_Potion_ExplosionOverheadIfCountIsLessThan 5
@setvar! mconfig_Potion_ExplosionOverheadIfCountIsLessThanTimerCD 5000

# Explosion Potions - use at your own risk
@setvar! mconfig_Potion_AutoExplodePot 1

# Cleansing Brew
@setvar! mconfig_Potion_UseCleansingBrewAutomatically 0
@setvar! mconfig_Potion_CleansingBrewHpDiffTrigger 60

# Weapon Abilities
@setvar! mconfig_Weapon_UseAbility1 0
