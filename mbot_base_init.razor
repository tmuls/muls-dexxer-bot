@setvar! mconfig_Potion_CureHpDiffTrigger 5
# Refresh Pot
@setvar! mconfig_Potion_UseRefreshAutomatically 1
@setvar! mconfig_Potion_RefreshStamDiffTrigger 20
# Potions Overhead
@setvar! mconfig_Potion_ShowOverheads 0
