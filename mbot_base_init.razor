# Poison
@setvar! mconfig_Poison_AutomaticallyApply 1

# Parry
@setvar! mconfig_Parry_AutoTaunting 1
@setvar! mconfig_Parry_AutoAoeTaunting 0
@setvar! mconfig_Parry_TauntingTimerCD 15000
@setvar! mconfig_Parry_AutoTauntHpDiffTrigger 20
@setvar! mconfig_Parry_CodexMinMana 13
@setvar! mconfig_Parry_SwitchToWardingIfBleeding 0
@setvar! mconfig_Parry_SwitchToWardingIfDisease 1
@setvar! mconfig_Parry_SwitchToWardingIfPoison 1
@setvar! mconfig_Parry_SwitchToBulwarkIfStandingStill 0
@setvar! mconfig_Parry_SwitchToShieldBashWhileMoving 0
@setvar! mconfig_Parry_SwitchToWardingIfBleedingHpDiff 25
@setvar! mconfig_Parry_SwitchToWardingIfDiseaseHpDiff 25
@setvar! mconfig_Parry_SwitchToWardingIfPoisonHpDiff 25
# 1 = Shield Bash, 2 = Warding, 3 = Testudo, 4 = Mirror, 5 = Bulwark
@setvar! mconfig_Parry_SwitchToDefaultStance 1

#####  DiffTrigger Explansion  #######
# Trigger HP = your max hp - init value
# 100 Health - 1 HP DIFF = 99 HEALTH TRIGGER
# 120 Health - 31 HP DIFF = 89 HEALTH TRIGGER

# Healing - Bandages
@setvar! mconfig_Healing_AutoBandageHpDiffTrigger 1

# Healing - Chiv
@setvar! mconfig_Chiv_AutoHolyLightHpDiffTrigger 60
@setvar! mconfig_Chiv_UseHolyLightAutomatically 1
@setvar! mconfig_Chiv_AutoUseNobleSacrificeHpDiffTrigger 80
@setvar! mconfig_Chiv_UseNobleSacrificeAutomatically 1

