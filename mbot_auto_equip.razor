################################################################
### Muls Auto Equip - v1.0
### Based on Piety's auto equip script.
### Dresses gear from the backpack using state recorded by
### mbot_base.razor's Gear State Tracking section (mbot_AutoEquip_*,
### mbot_BOT_CurrentRightHandWeapon/LeftHandWeapon). Run mbot_base at
### least once first so that state exists.
################################################################

##### Weapon/Shield/Talisman (lift+drop, not dclick)
### mbot_BOT_CurrentRightHandWeapon/LeftHandWeapon still use the old
### always-defined-defaults-to-0 tracking style, not Piety's
### unsetvar style, so these check != 0 rather than varexist.
if mbot_BOT_CurrentRightHandWeapon != 0
    if find mbot_BOT_CurrentRightHandWeapon backpack as mbot_AutoEquipFound
        lift mbot_AutoEquipFound
        drop self firstvalid
        getlabel backpack mbot_PingCheck
        while queued
        endwhile
    endif
endif

if mbot_BOT_CurrentLeftHandWeapon != 0
    if find mbot_BOT_CurrentLeftHandWeapon backpack as mbot_AutoEquipFound
        lift mbot_AutoEquipFound
        drop self firstvalid
        getlabel backpack mbot_PingCheck
        while queued
        endwhile
    endif
endif

if varexist mbot_AutoEquip_Talisman
    if find mbot_AutoEquip_Talisman backpack as mbot_AutoEquipFound
        lift mbot_AutoEquipFound
        drop self firstvalid
        getlabel backpack mbot_PingCheck
        while queued
        endwhile
    endif
endif

##### Remaining Layers (dclick)
removelist mbot_AutoEquipList
createlist mbot_AutoEquipList
if varexist mbot_AutoEquip_InnerTorso
    pushlist mbot_AutoEquipList mbot_AutoEquip_InnerTorso
endif
